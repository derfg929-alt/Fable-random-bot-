# Fable Randomizer — example configuration.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Telegram (required) ----------------------------------------------------
# Token from @BotFather
BOT_TOKEN=PUT_BOT_TOKEN_HERE
# Bot username without the @ sign (used in referral links). If empty it is
# detected automatically at startup via getMe.
BOT_USERNAME=your_bot_username
# Numeric Telegram IDs that always have owner access (comma separated).
# Your own id can be found with @userinfobot.
OWNER_IDS=123456789

# --- Mini App / web server --------------------------------------------------
# Public HTTPS URL where the Mini App is served. Required for the in-bot
# "Открыть Mini App" button. Hosting platforms (Render/Railway) may set
# PUBLIC_URL / RENDER_EXTERNAL_URL automatically.
WEBAPP_URL=https://your-domain.example
HOST=0.0.0.0
# Most PaaS inject PORT; locally 8000 is used.
PORT=8000
# How long a Mini App initData signature stays valid, seconds.
INIT_DATA_MAX_AGE=86400

# --- Database ---------------------------------------------------------------
# SQLite (default, zero setup). The file is created automatically.
DATABASE_URL=sqlite+aiosqlite:///fable_randomizer.db
# PostgreSQL for production (requires: pip install asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fable_randomizer
DB_ECHO=false

# --- Time -------------------------------------------------------------------
TIMEZONE=Europe/Moscow

# --- Internal draw parameters (never shown to users) ------------------------
# Relative weight bonus per invited friend (0.0001 = 0.01%) and its cap.
REFERRAL_RATE=0.0001
MAX_REFERRAL_BONUS=0.10

# Minimum seconds between two notifications of the same type to one user.
NOTIFICATION_MIN_GAP_SECONDS=0
